---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="On this page" class="surface-card rounded-xl p-5">
  <p class="text-xs uppercase tracking-[0.14em] text-[var(--fg-muted)] font-semibold m-0">On this page</p>
  <ol class="mt-3 space-y-2 text-sm list-decimal pl-5 m-0">
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} class="no-underline hover:text-[var(--accent)]">
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
