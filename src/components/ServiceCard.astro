---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<article class="surface-card rounded-xl p-6 h-full">
  <h3 class="text-lg m-0">
    <a href={href} class="no-underline hover:text-[var(--accent)]">{title}</a>
  </h3>
  <p class="mt-3 text-sm text-[var(--fg-muted)] m-0">{description}</p>
  <a href={href} class="mt-4 inline-block text-sm font-medium text-[var(--accent)] no-underline"
    >Explore {title} →</a
  >
</article>
