---
interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {
    items.map((item) => (
      <div class="surface-card rounded-xl p-4">
        <dt class="text-xs uppercase tracking-[0.12em] text-[var(--fg-muted)] m-0">{item.label}</dt>
        <dd class="mt-2 text-xl font-semibold m-0">{item.value}</dd>
      </div>
    ))
  }
</dl>
