---
import { SITE } from '../lib/site';

interface Props {
  stage?: 'top' | 'mid' | 'bottom';
  title?: string;
  body?: string;
}

const { stage = 'mid', title, body } = Astro.props;

const copy = {
  top: {
    title: title ?? 'Useful reading, not a sales pitch',
    body: body ?? 'Subscribe for technical notes on AI-native delivery, ecommerce architecture and LLM SEO — written from systems we operate.',
    primaryLabel: 'Contact us about a resource',
    primaryHref: '/contact/',
  },
  mid: {
    title: title ?? 'Need a free technical audit?',
    body: body ?? 'Share a URL or a problem statement. We will tell you what an AI-native team would change first — and what we would leave alone.',
    primaryLabel: 'Request a technical audit',
    primaryHref: '/contact/',
  },
  bottom: {
    title: title ?? 'Book a 30-minute technical call',
    body: body ?? 'Talk to an engineer who ships production systems. No account-manager layer. Bring a real constraint; leave with a concrete next step.',
    primaryLabel: 'Book a technical call',
    primaryHref: '/contact/',
  },
}[stage];
---

<section class="container-page py-10">
  <div
    class="rounded-2xl px-6 py-10 md:px-10 border border-[var(--line)]"
    style="background: linear-gradient(135deg, color-mix(in srgb, var(--nav) 92%, var(--accent)), var(--nav)); color: #f5f7fa;"
  >
    <h2 class="text-2xl md:text-3xl m-0 text-white">{copy.title}</h2>
    <p class="mt-3 max-w-2xl text-white/80 m-0">{copy.body}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href={copy.primaryHref}>{copy.primaryLabel}</a>
      <a class="btn-secondary border-white/25 text-white" href={SITE.whatsappUrl} rel="noopener noreferrer">
        WhatsApp {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
