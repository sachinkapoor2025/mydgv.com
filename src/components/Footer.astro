---
import { ADDRESSES, PAIRING_STATEMENT, SERVICES_NAV, SITE } from '../lib/site';
---

<footer class="mt-20 border-t border-[var(--line)] bg-[var(--nav)] text-[#e8edf5]">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <p class="text-white font-semibold text-lg tracking-tight">{SITE.name}</p>
        <p class="mt-3 text-sm leading-relaxed text-[#d5dbe6]">
          {PAIRING_STATEMENT}
        </p>
        <p class="mt-4 text-sm">
          <a class="text-[#7dd3fc] no-underline hover:underline inline-flex min-h-11 items-center" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <br />
          <a class="text-[#7dd3fc] no-underline hover:underline inline-flex min-h-11 items-center" href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
        </p>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-[0.14em] text-[#d5dbe6] font-semibold mb-3">Company</h2>
        <ul class="space-y-1 text-sm list-none p-0 m-0">
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/about/">About</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/about/why-dgv/">Why DGV</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/how-we-build/">How we build</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/case-studies/">Case studies</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/products/">Products</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/careers/">Careers</a></li>
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-[0.14em] text-[#d5dbe6] font-semibold mb-3">Services</h2>
        <ul class="space-y-1 text-sm list-none p-0 m-0">
          {
            SERVICES_NAV.slice(0, 8).map((s) => (
              <li>
                <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href={s.href}>
                  {s.title}
                </a>
              </li>
            ))
          }
          <li><a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/services/">All services</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-[0.14em] text-[#d5dbe6] font-semibold mb-3">Locations</h2>
        <ul class="space-y-3 text-sm list-none p-0 m-0 text-[#d5dbe6]">
          <li>
            <span class="block text-white">{ADDRESSES.operational.name}</span>
            {ADDRESSES.operational.line}
          </li>
          <li>
            <span class="block text-white">{ADDRESSES.warehouse.name}</span>
            {ADDRESSES.warehouse.line}
          </li>
          <li class="flex flex-wrap gap-x-3 gap-y-1">
            <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/locations/united-states/">United States</a>
            <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/locations/united-kingdom/">UK</a>
            <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/locations/">All markets</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/20 flex flex-col md:flex-row gap-3 md:items-center md:justify-between text-sm text-[#d5dbe6]">
      <p class="m-0">© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p class="m-0 flex flex-wrap gap-x-4 gap-y-2">
        <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/legal/privacy-policy/">Privacy policy</a>
        <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/legal/terms/">Terms</a>
        <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/security-and-compliance/">Security &amp; compliance</a>
        <a class="no-underline hover:text-white inline-flex min-h-11 items-center" href="/sitemap-index.xml">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
