---
interface Props {
  title: string;
  avoid: string;
  claim: string;
  href: string;
  linkLabel: string;
}

const { title, avoid, claim, href, linkLabel } = Astro.props;
---

<a
  href={href}
  class="surface-card block rounded-xl p-6 no-underline transition hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--accent)_50%,var(--line))]"
>
  <h3 class="text-lg m-0">{title}</h3>
  <p class="mt-2 text-xs uppercase tracking-[0.12em] text-[var(--accent)] font-semibold m-0">
    We skip {avoid}
  </p>
  <p class="mt-3 text-sm text-[var(--fg-muted)] m-0">{claim}</p>
  <span class="mt-4 inline-block text-sm font-medium text-[var(--accent)]">{linkLabel} →</span>
</a>
