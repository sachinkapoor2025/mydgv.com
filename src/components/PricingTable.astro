---
interface Tier {
  name: string;
  price: string;
  description: string;
  features: string[];
  href?: string;
  highlighted?: boolean;
}

interface Props {
  tiers: Tier[];
}

const { tiers } = Astro.props;
---

<div class="grid md:grid-cols-3 gap-4">
  {
    tiers.map((tier) => (
      <article
        class:list={[
          'surface-card rounded-xl p-6 flex flex-col',
          tier.highlighted && 'border-[color-mix(in_srgb,var(--accent)_55%,var(--line))]',
        ]}
      >
        <h3 class="text-xl m-0">{tier.name}</h3>
        <p class="mt-2 text-2xl font-semibold m-0">{tier.price}</p>
        <p class="mt-3 text-sm text-[var(--fg-muted)] m-0">{tier.description}</p>
        <ul class="mt-5 space-y-2 text-sm flex-1">
          {tier.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
        {tier.href && (
          <a href={tier.href} class="btn-primary mt-6 text-center">
            Discuss {tier.name}
          </a>
        )}
      </article>
    ))
  }
</div>
