---
import Layout from '../components/Layout.astro';

const title = 'Page not found';
const description = 'The page you requested does not exist. Return home or contact Divit Global Ventures.';
---

<Layout title={title} description={description} path="/404/" noindex={true}>
  <section class="container-narrow py-24 text-center">
    <p class="text-sm uppercase tracking-[0.16em] text-[var(--accent)] font-semibold m-0">404</p>
    <h1 class="mt-3 text-4xl m-0">Page not found</h1>
    <p class="mt-4 text-[var(--fg-muted)]">
      That URL is not in the new site map. Try the homepage, services overview, or contact us.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn-primary" href="/">Go to homepage</a>
      <a class="btn-secondary" href="/services/">Browse services</a>
      <a class="btn-secondary" href="/contact/">Contact DGV</a>
    </div>
  </section>
</Layout>
